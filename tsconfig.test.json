{
  "compilerOptions": {
    "composite": true,
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "emitDeclarationOnly": true,
    "jsx": "react-jsx",
    "skipLibCheck": true,
    "strictNullChecks": true,
    "types": ["vitest/globals", "vite/client"]
  },
  "include": ["tests", "src"]
}
